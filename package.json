{
  "name": "@approvio/frontend",
  "author": "Giovanni Baratta",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mocks": "VITE_USE_MOCKS=true vite",
    "build": "tsc -b && vite build",
    "lint": "eslint --cache --fix .",
    "preview": "vite preview",
    "format:prettier": "yarn prettier --config .prettierrc . --write",
    "generate:ui-components": "npx shadcn@latest add alert badge button card dialog input label scroll-area select skeleton sonner switch table textarea tooltip --overwrite",
    "test": "yarn test:e2e && yarn test:ct",
    "test:ci": "yarn test:e2e:ci && yarn test:ct:ci",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:e2e:ci": "PLAYWRIGHT_HTML_OPEN=never yarn test:e2e",
    "test:ct": "playwright test -c playwright-ct.config.ts",
    "test:ct:ci": "PLAYWRIGHT_HTML_OPEN=never yarn test:ct",
    "playwright:deps": "playwright install --with-deps"
  },
  "dependencies": {
    "@approvio/api": "0.0.40",
    "@approvio/ts-sdk": "0.0.13",
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@reduxjs/toolkit": "2.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fp-ts": "2.16.11",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "prismjs": "^1.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-redux": "9.2.0",
    "react-router-dom": "7.6.1",
    "react-simple-code-editor": "^0.14.1",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "^1.58.2",
    "@playwright/test": "^1.58.2",
    "@types/eslint-plugin-tailwindcss": "^3",
    "@types/node": "22.15.29",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.0",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.3.1",
    "eslint": "9.28.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "globals": "16.2.0",
    "msw": "^2.12.10",
    "postcss": "^8.5.10",
    "prettier": "3.3.3",
    "tailwindcss": "^3.4.15",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.0",
    "vite": "^6.4.2"
  },
  "packageManager": "yarn@4.7.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
